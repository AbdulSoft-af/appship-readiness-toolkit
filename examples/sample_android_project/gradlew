#!/usr/bin/env sh
# AppShip's small self-bootstrapping Gradle launcher.
# It downloads only the pinned official Gradle distribution and verifies SHA-256 before use.
set -eu
VERSION="8.14.6"
EXPECTED_SHA256="7988ed071b2a07900e2ec715fca15c6ab72bce6db433af301fa7fa7e9407bd24"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
DIST_ROOT="$GRADLE_USER_HOME/wrapper/dists/appship-gradle-$VERSION-bin"
GRADLE_HOME="$DIST_ROOT/gradle-$VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_ROOT"
  ZIP="$DIST_ROOT/gradle-$VERSION-bin.zip"
  if [ ! -s "$ZIP" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl --fail --location --retry 3 --connect-timeout 20 "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" --output "$ZIP"
    elif command -v wget >/dev/null 2>&1; then
      wget --https-only --tries=3 "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -O "$ZIP"
    else
      echo "AppShip: install curl or wget to download the pinned Gradle distribution." >&2
      exit 2
    fi
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA256="$(sha256sum "$ZIP" | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then
    ACTUAL_SHA256="$(shasum -a 256 "$ZIP" | awk '{print $1}')"
  else
    echo "AppShip: sha256sum/shasum is required to verify the Gradle download." >&2
    exit 2
  fi
  if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
    rm -f "$ZIP"
    echo "AppShip: Gradle SHA-256 verification failed; refusing to execute the download." >&2
    exit 3
  fi
  rm -rf "$GRADLE_HOME"
  unzip -q "$ZIP" -d "$DIST_ROOT"
  if [ ! -x "$GRADLE_BIN" ]; then
    echo "AppShip: downloaded archive did not contain the expected Gradle executable." >&2
    exit 4
  fi
  rm -f "$ZIP"
fi
exec "$GRADLE_BIN" "$@"
